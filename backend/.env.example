# Copie para .env e ajuste os valores
DJANGO_DEBUG=True
# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Banco: deixe vazio para usar SQLite local.
# Para o Neon, cole a connection string do painel (Connect > Pooled connection), ex.:
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/meudindin?sslmode=require
DATABASE_URL=

# E-mail (Brevo). Prioridade: BREVO_API_KEY (API HTTP, obrigatória no Render free, que bloqueia SMTP)
# > BREVO_SMTP_KEY (SMTP, bom localmente) > nenhum (e-mails aparecem no terminal do Django).
# Chave de API: Brevo > Settings > SMTP & API > API Keys (começa com xkeysib-)
BREVO_API_KEY=
# Login e chave: painel do Brevo > Settings > SMTP & API > SMTP
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Remetente verificado no Brevo (Settings > Senders, domains & IPs)
EMAIL_FROM=MeuDinDin <seu-remetente@seudominio.com>
EMAIL_TAG=meudindin
FRONTEND_URL=http://localhost:5173

# Chave dos dados protegidos no banco (segredo do 2FA, hash dos códigos).
# Use o MESMO valor em todo ambiente que compartilha o banco (local e Render no mesmo Neon).
# Vazia = usa o DJANGO_SECRET_KEY. Trocar depois invalida os 2FA já ativados.
DATA_ENCRYPTION_KEY=

# Produção (Render): quantos proxies confiáveis à frente do Django (para o IP real do cliente)
# TRUSTED_PROXY_COUNT=1
